{
  "name": "vertexia-retail-pos",
  "private": true,
  "version": "1.0.0",
  "main": "electron-dist/electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agency": "npm run build:electron && node scripts/local-agency.mjs",
    "dev:desktop": "npm run build:electron && node scripts/dev-desktop.mjs",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "node -e \"require('node:fs').rmSync('electron-dist',{recursive:true,force:true})\" && tsc -p electron/tsconfig.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "start:desktop": "npm run build && node scripts/start-desktop.mjs",
    "test:desktop": "npm run build && node scripts/smoke-retail.mjs --dashboard",
    "test:desktop:pos": "npm run build && node scripts/smoke-retail.mjs --pos",
    "test:desktop:products": "npm run build && node scripts/smoke-retail.mjs --products",
    "test:dashboard": "npm run build:electron && node --test tests/dashboard.database.test.mjs",
    "test:pos": "npm run build:electron && node --test tests/pos.database.test.mjs",
    "test:products": "npm run build:electron && node --test tests/products.database.test.mjs",
    "test:sales": "npm run build:electron && node --test tests/sales.database.test.mjs",
    "test:retail": "npm run build:electron && node --test tests/retail.database.test.mjs",
    "test:database": "npm run build:electron && node --test tests/*.database.test.mjs",
    "test:desktop:retail": "npm run build && node scripts/smoke-retail.mjs",
    "test:auth": "npm run build:electron && node --test tests/auth.database.test.mjs",
    "test:desktop:auth": "npm run build && node scripts/smoke-retail.mjs --auth",
    "test:cash": "npm run build:electron && node --test tests/cash.database.test.mjs",
    "test:backup": "npm run build:electron && node --test tests/backup.database.test.mjs",
    "test:desktop:recovery": "npm run build && node scripts/smoke-retail.mjs --recovery",
    "test:accounts": "npm run build:electron && node --test tests/accounts.database.test.mjs",
    "test:desktop:accounts": "npm run build && node scripts/smoke-retail.mjs --accounts",
    "test:reports": "npm run build:electron && node --test tests/reports.database.test.mjs",
    "test:desktop:reports": "npm run build && node scripts/smoke-retail.mjs --reports",
    "test:branches": "npm run build:electron && node --test tests/branches.database.test.mjs",
    "test:desktop:branches": "npm run build && node scripts/smoke-retail.mjs --branches",
    "test:licensing": "npm run build:electron && node --test tests/licensing.database.test.mjs",
    "test:desktop:licensing": "npm run build && node scripts/smoke-retail.mjs --licensing",
    "company:license": "node scripts/company-license.mjs",
    "test:agency": "npm run build:electron && node --test tests/agency.database.test.mjs",
    "test:desktop:agency": "npm run build:electron && node scripts/smoke-agency.mjs",
    "company:package": "npm run build:electron && node scripts/package-agency.mjs",
    "company:backup": "node scripts/backup-company.mjs",
    "company:verify": "node scripts/verify-agency-deployment.mjs",
    "test:deployment": "npm run build:electron && node --test tests/deployment.database.test.mjs",
    "test:agency:local": "npm run build:electron && node --test tests/local-agency.database.test.mjs",
    "test:desktop:agency:local": "npm run build:electron && node scripts/smoke-agency.mjs --local-setup"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^14.0.0",
    "jsbarcode": "^3.12.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
